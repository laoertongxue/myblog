12lab.cn {
	root * /var/www/12lab.cn/current
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Deliberately without includeSubDomains/preload: HSTS is cached by
		# browsers and this site does not control every subdomain. 180 days is
		# the conservative recommendation; raise it only on purpose.
		Strict-Transport-Security "max-age=15552000"
		# Read and enforced by scripts/run-browser-checks.mjs, so every browser
		# check also runs against this exact policy (a blocked script, style or
		# picture fails the build instead of silently degrading it).
		#   script-src 'self'      - all scripts are fingerprinted files, no inline JS
		#   style-src 'unsafe-inline' - required by the thumbnail-count style attribute
		#   img-src https:         - docs/列表缩略图.md allows remote HTTPS pictures
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'"
	}

	# Only content-addressed resources are safe to cache immutably.
	@versioned path_regexp versioned [._][a-f0-9]{16,64}\.(css|js|json|png|jpg|jpeg|gif|webp|svg|woff|woff2)$
	header @versioned Cache-Control "public, max-age=31536000, immutable"
	@mutable not path_regexp mutable [._][a-f0-9]{16,64}\.(css|js|json|png|jpg|jpeg|gif|webp|svg|woff|woff2)$
	header @mutable Cache-Control "no-cache"

	file_server
	handle_errors 404 {
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}
