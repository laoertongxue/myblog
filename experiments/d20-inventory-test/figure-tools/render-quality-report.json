        "y": 781,
        "w": 378,
        "h": 42
      },
      {
        "text": "没有成本，就不称经济最优",
        "x": 56,
        "y": 860,
        "w": 420,
        "h": 35
      },
      {
        "text": "没有效期，就不推断报废改善",
        "x": 56,
        "y": 921,
        "w": 442,
        "h": 34
      },
      {
        "text": "禾味：数量用公斤",
        "x": 32,
        "y": 1091,
        "w": 320,
        "h": 40
      },
      {
        "text": "匿名服装：数量用件",
        "x": 32,
        "y": 1165,
        "w": 360,
        "h": 40
      },
      {
        "text": "两案分开比较，不相加评分。",
        "x": 32,
        "y": 1242,
        "w": 468,
        "h": 36
      },
      {
        "text": "模拟结果不等于真实项目收益。",
        "x": 32,
        "y": 1365,
        "w": 490,
        "h": 35
      }
    ]
