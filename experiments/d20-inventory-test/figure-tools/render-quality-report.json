  {
    "name": "d20-02_metrics",
    "width": 700,
    "height": 1530,
    "textBoundsPassed": true,
    "textOverlap": false,
    "textBoxes": [
      {
        "text": "四项指标，四种问题",
        "x": 32,
        "y": 33,
        "w": 396,
        "h": 44.57147216796875
      },
      {
        "text": "01  平均现存",
        "x": 56,
        "y": 149,
        "w": 224.40625,
        "h": 42
      },
      {
        "text": "日末现存之和 ÷ 测试天数",
        "x": 56,
        "y": 229,
        "w": 403.5625,
        "h": 35
      },
      {
        "text": "不含在途，不代表日内平均",
        "x": 56,
        "y": 297,
        "w": 408,
        "h": 34
      },
      {
        "text": "02  单位满足率",
        "x": 56,
        "y": 439,
        "w": 266.40625,
        "h": 42
      },
      {
        "text": "满足需求合计 ÷ 需求合计",
        "x": 56,
        "y": 519,
        "w": 403.5625,
        "h": 35
      },
      {
        "text": "总需求为零时记为不适用",
        "x": 56,
        "y": 587,
        "w": 374,
        "h": 34
      },
      {
        "text": "03  失销量",
        "x": 56,
        "y": 729,
        "w": 182.40625,
        "h": 42
      },
      {
        "text": "需求合计 − 满足需求合计",
        "x": 56,
        "y": 809,
        "w": 403.5625,
        "h": 35
      },
      {
        "text": "未满足就失销，不转为欠交",
        "x": 56,
        "y": 877,
        "w": 408,
        "h": 34
      },
      {
        "text": "04  订单次数",
        "x": 56,
        "y": 1019,
        "w": 224.99307250976562,
        "h": 42
      },
      {
        "text": "只数订货量大于零的事件",
        "x": 56,
        "y": 1099,
        "w": 385,
        "h": 35
      },
      {
        "text": "到了复核日，也可能不下单",
        "x": 56,
        "y": 1167,
        "w": 408,
        "h": 34
      },
      {
        "text": "满足率 ≠ 周期服务水平",
        "x": 32,
        "y": 1339,
        "w": 431.734375,
        "h": 41
      },
      {
        "text": "比较指标，不混淆业务含义。",
        "x": 32,
        "y": 1418,
        "w": 468,
        "h": 36
      }
    ]
  },
  {
    "name": "d20-03_tradeoff",
    "width": 700,
    "height": 1450,
    "textBoundsPassed": true,
    "textOverlap": false,
    "textBoxes": [
      {
        "text": "怎样读库存与缺货取舍",
        "x": 32,
        "y": 34,
        "w": 430.1536865234375,
        "h": 43
      },
      {
        "text": "先看：是否少缺货",
        "x": 56,
        "y": 151,
        "w": 336,
        "h": 42
